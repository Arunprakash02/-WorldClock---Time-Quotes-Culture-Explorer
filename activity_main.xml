<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Background Image -->
        <ImageView
            android:id="@+id/ivBackground"
            android:layout_width="100dp"
            android:layout_gravity="center"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:src="@drawable/default_products" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Country Time App"
            android:textSize="23sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_600"
            android:textColor="#000000"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Why do you love this country?"
            android:textSize="16sp"
            android:fontFamily="@font/inter_600"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

        <EditText
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:background="@android:drawable/editbox_background"
            android:padding="10dp"
            android:hint="Type your Name"
            android:fontFamily="@font/inter_600" />


        <!-- Country Selection Spinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Country"
            android:textSize="16sp"
            android:fontFamily="@font/inter_600"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

        <Spinner
            android:id="@+id/spinnerCountry"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:fontFamily="@font/inter_600"
            android:background="@android:drawable/editbox_background" />

        <!-- Why You Love This Country -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Why do you love this country?"
            android:textSize="16sp"
            android:fontFamily="@font/inter_600"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

        <EditText
            android:id="@+id/etReason"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_70"
            android:minLines="4"
            android:fontFamily="@font/inter_600"
            android:maxLines="6"
            android:inputType="textMultiLine"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:hint="Type your reason here..." />

        <!-- Submit Button -->

        <!-- Result Card -->
        <TextView
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:background="@drawable/common_white_bg_grey_stroke_green"
            android:fontFamily="@font/inter_500"
            android:gravity="center"
            android:text="SUBMIT"
            android:textColor="@color/black"
            android:textSize="20sp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            android:visibility="gone"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Country Image -->
                <ImageView
                    android:id="@+id/ivCountryImage"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/default_products" />

                <!-- Country Name -->
                <TextView
                    android:id="@+id/tvCountryName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginTop="12dp" />

                <!-- Current Time -->
                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="#000000"
                    android:layout_marginTop="8dp" />

                <!-- Timezone -->
                <TextView
                    android:id="@+id/tvTimeZone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#808080"
                    android:layout_marginTop="4dp" />

                <!-- Quote -->
                <TextView
                    android:id="@+id/tvQuote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="italic"
                    android:textColor="#000000"
                    android:layout_marginTop="12dp" />

                <!-- Reason -->
                <TextView
                    android:id="@+id/tvReason"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>